# ── Local dev: copy this file to .env and fill in real values ─────────────────
# ── Production (Lambda): secrets go to SSM, config stays in Lambda env vars ───
#
# SECRETS → AWS SSM Parameter Store (/indian-stock-analyzer/prod/<KEY>)
#   Lambda reads these at cold start via load_secrets_from_ssm().
#   Never set these as Lambda environment variables.
#
# CONFIG  → Lambda environment variables (non-sensitive, visible in console is fine)
#   Set these directly in Lambda → Configuration → Environment variables.
#   All CONFIG values are read via pydantic-settings (src/analyzer/config/settings.py)
#   and validated at startup — a bad value fails loudly, not silently mid-pipeline.


# ══════════════════════════════════════════════════════════════════════════════
# SECRETS → SSM
# ══════════════════════════════════════════════════════════════════════════════

# ── LLM providers ─────────────────────────────────────────────────────────────
# Primary: OpenAI. Get from platform.openai.com → API keys
OPENAI_API_KEY=sk-...

# Fallback: Gemini Flash (free 1M tokens/day). Get from aistudio.google.com
GEMINI_API_KEY=AIza...

# ── Tracing ───────────────────────────────────────────────────────────────────
# Get from smith.langchain.com → Settings → API Keys
LANGSMITH_API_KEY=lsv2_...

# ── Delivery ──────────────────────────────────────────────────────────────────
# Telegram: create bot via @BotFather, get your chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=123456789:ABC...
TELEGRAM_CHAT_IDS=987654321         # comma-separated for multiple: 111,222,333

# Gmail: use an App Password (not your real password)
# myaccount.google.com → Security → App passwords
GMAIL_SENDER=you@gmail.com
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# ── API auth ───────────────────────────────────────────────────────────────────
# Random secret for protected endpoints (/latest, /accuracy, /morning, /hitl/*)
# Leave empty for local dev (open access). Generate with: openssl rand -hex 32
API_KEY=your-random-secret-here

# ── HITL (only needed when ENABLE_HITL=true) ──────────────────────────────────
# Your personal Telegram chat ID (message @userinfobot to get it)
ADMIN_CHAT_ID=123456789


# ══════════════════════════════════════════════════════════════════════════════
# CONFIG → Lambda env vars  (safe to show in console, not sensitive)
# ══════════════════════════════════════════════════════════════════════════════

# ── Storage ───────────────────────────────────────────────────────────────────
# local = JSON files under data/  |  s3 = AWS S3 (required for Lambda)
STORAGE_BACKEND=local
# Only needed when STORAGE_BACKEND=s3
S3_BUCKET_NAME=your-bucket-name

# ── Observability ─────────────────────────────────────────────────────────────
# pretty = colored terminal output  |  json = structured JSON for CloudWatch
LOG_FORMAT=pretty
LOG_LEVEL=INFO
LANGCHAIN_PROJECT=indian-stock-analyzer
LANGCHAIN_TRACING_V2=true

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Base URL of your deployed API — used in HITL Telegram button links
API_BASE_URL=http://localhost:8000


# ══════════════════════════════════════════════════════════════════════════════
# PHASE 3A — Intelligence & Safety
# ══════════════════════════════════════════════════════════════════════════════

# ── Feature toggles ───────────────────────────────────────────────────────────
ENABLE_AGENTIC_MODE=true      # LLM decides which MCP tools to call (vs fixed pipeline)
ENABLE_REFLECTION=true        # Smarter model reviews uncertain verdicts
ENABLE_HITL=false             # Human approval gate — keep false on Lambda (15 min timeout)
MEMORY_ENABLED=true           # Mem0 hierarchical memory (episodic/semantic/procedural)
INPUT_GUARD_ENABLED=true      # LLM Guard + Presidio on news snippets
GUARDRAILS_ENABLED=true       # Business-rule validators on verdict fields
NEMO_RAILS_ENABLED=true       # NeMo policy output rail

# ── LLM model selection ───────────────────────────────────────────────────────
# OpenAI free tier (data-sharing opt-in):
#   2.5M tokens/day bucket: gpt-5.4-mini, gpt-5-mini, gpt-4o-mini
#   250K tokens/day bucket: gpt-5, gpt-4o, o3
# Never hardcode model names elsewhere — change here only.
LLM_PRIMARY_MODEL=gpt-5.4-mini   # all bulk LLM work (agentic loop, analyst, Mem0)
LLM_SMART_MODEL=gpt-5            # reflection reviewer only (~27K tokens/day)
# LLM_FALLBACK_MODEL=gemini/gemini-1.5-flash   # auto-used when primary fails

# ── Token budget ──────────────────────────────────────────────────────────────
# DAILY_TOKEN_LIMIT moved to config/settings.yaml (Phase 3B Task 3.13)

# ── Prompt versioning ─────────────────────────────────────────────────────────
# Prompts are YAML files in src/analyzer/llm/prompts/{name}_{version}.yaml
# Change version here to A/B test a new prompt without touching code.
# Phase 3B upgrade: LangSmith Hub replaces this — prompts pulled by commit hash.
PROMPT_VERSION_ANALYSIS=v1
PROMPT_VERSION_MORNING=v1
PROMPT_VERSION_REFLECTION=v1


# ══════════════════════════════════════════════════════════════════════════════
# TUNABLE THRESHOLDS — moved to config/settings.yaml (Phase 3B Task 3.13)
# ══════════════════════════════════════════════════════════════════════════════
# Thresholds (guardrail %, HITL triggers, token budget, news age, max tool calls)
# are no longer env vars — edit config/settings.yaml and commit the change so
# every threshold adjustment is visible in git history.


# ══════════════════════════════════════════════════════════════════════════════
# PHASE 3B — CI + Observability + ECS Pipeline
# ══════════════════════════════════════════════════════════════════════════════

# ── Memory: Qdrant Cloud (replaces local ChromaDB — survives Lambda cold starts) ──
# Free tier: 1 GB forever. Get from https://cloud.qdrant.io/
# Leave empty to use local ChromaDB (dev only — ephemeral on Lambda/ECS)
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# ── Search: Tavily macro-news MCP tool ────────────────────────────────────────
# Free tier: 1,000 searches/month. Get from https://tavily.com/
# Used by the agentic loop when it calls get_macro_news()
TAVILY_API_KEY=tvly-...

# ── Observability: Langfuse prompt registry + tracing ─────────────────────────
# Free cloud tier. Get from https://cloud.langfuse.com/ → Settings → API Keys
# Leave empty to use local YAML prompts (always works without Langfuse)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com   # change for self-hosted (Phase 4)

# ── Observability: Sentry error tracking ──────────────────────────────────────
# Free tier: 5,000 errors/month. Get from https://sentry.io/ → Settings → Projects
# Leave empty to disable Sentry (pipeline runs without it)
SENTRY_DSN=https://abc123@o123.ingest.sentry.io/456

# ── Observability: OpenTelemetry (vendor-neutral request + LLM spans) ─────────
# Set to your OTLP/HTTP collector endpoint.
# Leave empty to disable OTel tracing.
# Examples:
#   Local Jaeger:     http://localhost:4318
#   Grafana Cloud:    https://otlp-gateway-prod-us-central-0.grafana.net/otlp
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── ECS pipeline: release tag for Sentry correlation ──────────────────────────
# Injected by CI at deploy time: GIT_SHA=$(git rev-parse --short HEAD)
# No need to set manually in .env — only needed in ECS task definition / CI
# GIT_SHA=abc1234

# ── ECS pipeline: job selector ────────────────────────────────────────────────
# Set in ECS task definition environment block — not in .env
# PIPELINE_JOB=4pm     # or "morning"
# ENVIRONMENT=production


# ══════════════════════════════════════════════════════════════════════════════
# PHASE 3C — Auth & Payments (Task 3.21)
# ══════════════════════════════════════════════════════════════════════════════

# ── Auth.js / NextAuth v5 ─────────────────────────────────────────────────────
# Shared HS256 signing secret — MUST be identical in Vercel and Lambda env vars.
# Both Next.js (Auth.js) and FastAPI (_require_user_jwt) use this to sign/verify JWTs.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Leave empty in local dev for open access (no auth enforced on either side).
NEXTAUTH_SECRET=your-32-byte-random-hex-secret
# Required in local dev so Auth.js knows the canonical URL for OAuth redirects.
# In production (Vercel) this is set automatically; you only need it locally.
NEXTAUTH_URL=http://localhost:3000

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create at console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Authorized redirect URIs:
#   Local:  http://localhost:3000/api/auth/callback/google
#   Prod:   https://your-domain.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ── Razorpay ──────────────────────────────────────────────────────────────────
# API keys: dashboard.razorpay.com → Settings → API Keys → Generate Test/Live key pair
# Test keys have prefix rzp_test_, live keys have prefix rzp_live_
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Webhook secret: dashboard.razorpay.com → Settings → Webhooks → your webhook → Secret
# The secret is used to verify HMAC-SHA256 signatures on incoming webhook events.
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ── DynamoDB user store ───────────────────────────────────────────────────────
# Table is created manually — see docs/manual-infra.md for CLI commands.
# Override only if you use a different table name (e.g., analyzer-users-staging).
# USERS_TABLE=analyzer-users-prod   # default; no need to set unless overriding
