# ── Local dev: copy this file to .env and fill in real values ─────────────────
# ── Production (Lambda): secrets go to SSM, config stays in Lambda env vars ───
#
# SECRETS → AWS SSM Parameter Store (/indian-stock-analyzer/prod/<KEY>)
#   Lambda reads these at cold start via load_secrets_from_ssm().
#   Never set these as Lambda environment variables.
#
# CONFIG  → Lambda environment variables (non-sensitive, visible in console is fine)
#   Set these directly in Lambda → Configuration → Environment variables.
#   All CONFIG values are read via pydantic-settings (src/analyzer/config/settings.py)
#   and validated at startup — a bad value fails loudly, not silently mid-pipeline.


# ══════════════════════════════════════════════════════════════════════════════
# SECRETS → SSM
# ══════════════════════════════════════════════════════════════════════════════

# ── LLM providers ─────────────────────────────────────────────────────────────
# Primary: OpenAI. Get from platform.openai.com → API keys
OPENAI_API_KEY=sk-...

# Fallback: Gemini Flash (free 1M tokens/day). Get from aistudio.google.com
GEMINI_API_KEY=AIza...

# ── Tracing ───────────────────────────────────────────────────────────────────
# Get from smith.langchain.com → Settings → API Keys
LANGSMITH_API_KEY=lsv2_...

# ── Delivery ──────────────────────────────────────────────────────────────────
# Telegram: create bot via @BotFather, get your chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=123456789:ABC...
TELEGRAM_CHAT_IDS=987654321         # comma-separated for multiple: 111,222,333

# Gmail: use an App Password (not your real password)
# myaccount.google.com → Security → App passwords
GMAIL_SENDER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── API auth ───────────────────────────────────────────────────────────────────
# Random secret for protected endpoints (/latest, /accuracy, /morning, /hitl/*)
# Leave empty for local dev (open access). Generate with: openssl rand -hex 32
API_KEY=your-random-secret-here

# ── HITL (only needed when ENABLE_HITL=true) ──────────────────────────────────
# Your personal Telegram chat ID (message @userinfobot to get it)
ADMIN_CHAT_ID=123456789


# ══════════════════════════════════════════════════════════════════════════════
# CONFIG → Lambda env vars  (safe to show in console, not sensitive)
# ══════════════════════════════════════════════════════════════════════════════

# ── Storage ───────────────────────────────────────────────────────────────────
# local = JSON files under data/  |  s3 = AWS S3 (required for Lambda)
STORAGE_BACKEND=local
# Only needed when STORAGE_BACKEND=s3
S3_BUCKET_NAME=your-bucket-name

# ── Observability ─────────────────────────────────────────────────────────────
# pretty = colored terminal output  |  json = structured JSON for CloudWatch
LOG_FORMAT=pretty
LOG_LEVEL=INFO
LANGCHAIN_PROJECT=indian-stock-analyzer
LANGCHAIN_TRACING_V2=true

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Base URL of your deployed API — used in HITL Telegram button links
API_BASE_URL=http://localhost:8000


# ══════════════════════════════════════════════════════════════════════════════
# PHASE 3A — Intelligence & Safety
# ══════════════════════════════════════════════════════════════════════════════

# ── Feature toggles ───────────────────────────────────────────────────────────
ENABLE_AGENTIC_MODE=true      # LLM decides which MCP tools to call (vs fixed pipeline)
ENABLE_REFLECTION=true        # Smarter model reviews uncertain verdicts
ENABLE_HITL=false             # Human approval gate — keep false on Lambda (15 min timeout)
MEMORY_ENABLED=true           # Mem0 hierarchical memory (episodic/semantic/procedural)
INPUT_GUARD_ENABLED=true      # LLM Guard + Presidio on news snippets
GUARDRAILS_ENABLED=true       # Business-rule validators on verdict fields
NEMO_RAILS_ENABLED=true       # NeMo policy output rail

# ── LLM model selection ───────────────────────────────────────────────────────
# OpenAI free tier (data-sharing opt-in):
#   2.5M tokens/day bucket: gpt-5.4-mini, gpt-5-mini, gpt-4o-mini
#   250K tokens/day bucket: gpt-5, gpt-4o, o3
# Never hardcode model names elsewhere — change here only.
LLM_PRIMARY_MODEL=gpt-5.4-mini   # all bulk LLM work (agentic loop, analyst, Mem0)
LLM_SMART_MODEL=gpt-5            # reflection reviewer only (~27K tokens/day)
# LLM_FALLBACK_MODEL=gemini/gemini-1.5-flash   # auto-used when primary fails

# ── Token budget ──────────────────────────────────────────────────────────────
DAILY_TOKEN_LIMIT=2500000         # 2.5M = OpenAI free tier for mini bucket

# ── Prompt versioning ─────────────────────────────────────────────────────────
# Prompts are YAML files in src/analyzer/llm/prompts/{name}_{version}.yaml
# Change version here to A/B test a new prompt without touching code.
# Phase 3B upgrade: LangSmith Hub replaces this — prompts pulled by commit hash.
PROMPT_VERSION_ANALYSIS=v1
PROMPT_VERSION_MORNING=v1
PROMPT_VERSION_REFLECTION=v1


# ══════════════════════════════════════════════════════════════════════════════
# TUNABLE THRESHOLDS
# All values below have sensible defaults — only change after testing.
# pydantic-settings validates types and ranges at startup (src/analyzer/config/settings.py).
# ══════════════════════════════════════════════════════════════════════════════

# ── Reflection ────────────────────────────────────────────────────────────────
# REFLECTION_CONFIDENCE_THRESHOLD=0.65   # reflect on BUY/SELL below this confidence
# REVIEWER_MODEL=                        # empty = use LLM_SMART_MODEL

# ── Guardrails ────────────────────────────────────────────────────────────────
# MAX_GUARD_RETRIES=2
# GUARDRAIL_ENTRY_DEVIATION_PCT=0.05     # entry must be within this % of current price
# GUARDRAIL_STOP_LOSS_MIN_PCT=0.02       # stop-loss minimum distance from entry
# GUARDRAIL_STOP_LOSS_MAX_PCT=0.08       # stop-loss maximum distance from entry
# GUARDRAIL_MIN_CONFIDENCE=0.60          # min confidence for a directional BUY/SELL call

# ── HITL ──────────────────────────────────────────────────────────────────────
# HITL_CONFIDENCE_TRIGGER=0.50           # HITL fires for directional calls below this
# HITL_LARGE_TARGET_UPSIDE=0.30          # HITL fires for BUY with upside above this ratio
# HITL_TIMEOUT_SECS=1800                 # 30 min — how long to wait for admin response
# HITL_DB_PATH=data/hitl.db

# ── Agentic loop ──────────────────────────────────────────────────────────────
# MAX_TOOL_CALLS=5                       # max tool calls per stock per run

# ── News ──────────────────────────────────────────────────────────────────────
# NEWS_MAX_AGE_DAYS=30                   # drop articles older than this
# NEWS_FRESH_DAYS=2                      # articles within this window get no age label
