# ── Lambda API ────────────────────────────────────────────────────────────────
# Lambda function URL (no trailing slash)
API_BASE_URL=https://<your-lambda-url>.lambda-url.us-east-1.on.aws

# X-API-Key — used only when NEXTAUTH_SECRET is not set (local dev without auth)
API_KEY=your-api-key-here

# ── Sentry (frontend) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://abc123@o123456.ingest.sentry.io/frontend-project-id
SENTRY_AUTH_TOKEN=sntrys_...

# ── Auth.js (Google OAuth) ────────────────────────────────────────────────────
# Generate NEXTAUTH_SECRET with: openssl rand -hex 32
# Must match the value stored in Lambda env / SSM (NEXTAUTH_SECRET)
NEXTAUTH_SECRET=your-32-byte-random-hex-secret
NEXTAUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ── Razorpay (payments) ───────────────────────────────────────────────────────
# Key ID is public (prefixed rzp_test_ in test mode, rzp_live_ in production)
RAZORPAY_KEY_ID=rzp_test_...
# Key secret — server-only, never exposed to the browser
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Plan ID created in the Razorpay dashboard (Settings → Plans)
RAZORPAY_PLAN_ID=plan_...
